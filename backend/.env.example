# BrightVale Finance backend configuration — copy to .env and fill in real values.
# Never commit the real .env.

# Server
PORT=5000
NODE_ENV=development

# Database (existing CrestCoin data lives in the 'crestcoin' database)
MONGODB_URI=mongodb://localhost:27017/crestcoin

# Auth — REQUIRED in production. Startup fails without it when NODE_ENV=production.
JWT_SECRET=

# Allowed frontend origins (comma-separated)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500

# Base URL used in password-reset / verification emails
FRONTEND_URL=http://localhost:3000

# ---- Email (env-only — there is NO test fallback and NO admin SMTP settings) ----
# Choose one provider and fill in its credentials. Startup warns (dev) or
# fails (production) when the selected provider is not fully configured.
EMAIL_PROVIDER=brevo            # brevo | resend
EMAIL_FROM_NAME=BrightVale Finance
EMAIL_FROM_EMAIL=noreply@yourdomain.com

# Brevo (SMTP relay) — https://app.brevo.com → SMTP & API
EMAIL_BREVO_LOGIN=              # your Brevo account email
EMAIL_BREVO_SMTP_KEY=           # Brevo SMTP key
EMAIL_BREVO_HOST=smtp-relay.brevo.com
EMAIL_BREVO_PORT=587

# Resend (HTTP API) — https://resend.com/api-keys (from-address must be a verified domain)
EMAIL_RESEND_API_KEY=

# Optional: require a 6-digit email OTP on every login (default off)
LOGIN_OTP=false

# Require email verification before dashboard access (default: off).
# When off, accounts work immediately and welcome emails are sent instead.
EMAIL_VERIFICATION_REQUIRED=false
